{
  "manifest_version": 3,
  "name": "SOP Creator - Optimized",
  "version": "2.0.0",
  "description": "Memory-optimized SOP creation with streaming video",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting",
    "desktopCapture",
    "activeTab"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "src/shared/constants.js",
        "src/shared/utils.js",
        "src/content-scripts/optimized-click-tracker.js"
      ],
      "run_at": "document_end"
    }
  ],
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "SOP Creator"
  }
}